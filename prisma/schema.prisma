generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MendeleyConfig {
  id            String   @id @default(cuid())
  clientId      String?
  clientSecret  String?
  accessToken   String?
  refreshToken  String?
  tokenExpiresAt DateTime?
  connected     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Reference {
  id          String   @id @default(cuid())
  type        String   @default("article")
  citationKey String?
  title       String
  authors     String
  year        String?
  journal     String?
  volume      String?
  number      String?
  pages       String?
  doi         String?
  abstract    String?
  tags        String?
  notes       String?
  source      String   @default("manual")
  mendeleyId  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Thesis Editor Models ─────────────────────────────────────

model Thesis {
  id            String    @id @default(cuid())
  title         String    @default("Ma thèse de doctorat")
  subtitle      String?
  author        String    @default("Doctorant")
  field         String    @default("")
  university    String   @default("")
  status        String    @default("draft")
  structureMode String    @default("chapters") // "chapters" | "parts"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  chapters      Chapter[]
  parts         Part[]
}

model Chapter {
  id               String    @id @default(cuid())
  thesisId         String
  partId           String?
  order            Int
  number           String
  title            String
  content          String    @default("")
  wordCount        Int       @default(0)
  status           String    @default("draft")
  directorFeedback String?
  directorFeedbackAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  thesis           Thesis    @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  part             Part?     @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@unique([thesisId, order])
}

model Part {
  id        String    @id @default(cuid())
  thesisId  String
  title     String    @default("")
  order     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  thesis    Thesis    @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  chapters  Chapter[]

  @@unique([thesisId, order])
}

model CloudDriveConnection {
  id           String    @id @default(cuid())
  provider     String    @default("google_drive") // google_drive, onedrive, dropbox
  connected    Boolean   @default(false)
  email        String?
  displayName  String?
  accessToken  String?
  refreshToken String?
  tokenExpiresAt DateTime?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── Notebook (recherche assistée par IA sur sources) ────────

model ResearchSource {
  id         String   @id @default(cuid())
  title      String
  content    String
  sourceType String   @default("text")
  tags       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model NotebookEntry {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sourceIds String   @default("")
  createdAt DateTime @default(now())
}