# ─── ThesisFrame — Variables d'environnement de production ───────────
# Copiez ce fichier à la racine du projet sous le nom `.env.production`
# et remplissez les valeurs entre [CROCHETS].
#
# NE COMMITTEZ JAMAIS ce fichier avec de vraies clés !

# ─── Base de données ─────────────────────────────────────────────
# Chemin SQLite dans le conteneur Docker (ne pas modifier)
DATABASE_URL=file:/app/data/thesis.db

# ─── IA — z-ai-web-dev-sdk ───────────────────────────────────────
# Clés fournies par votre fournisseur de modèles IA.
# Sur Infomaniak, vous pouvez utiliser les clés de leur API ou
# celles d'OpenAI / Mistral / autre fournisseur compatible.
ZAI_BASE_URL=[https://api.votre-fournisseur-ai.com/v1]
ZAI_API_KEY=[sk-votre-cle-api]

# ─── Application ─────────────────────────────────────────────────
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ─── OAuth (optionnel — Mendeley, Google Drive) ───────────────────
# Si vous activez la connexion Mendeley ou Google Drive :
# MENDELEY_CLIENT_ID=
# MENDELEY_CLIENT_SECRET=
# MENDELEY_REDIRECT_URI=https://thesisframe.votre-domaine.ch/api/mendeley/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://thesisframe.votre-domaine.ch/api/cloud-drive/callback

# ─── Infomaniak kDrive (optionnel — sauvegarde cloud) ─────────────
# Si vous utilisez kDrive d'Infomaniak pour les sauvegardes :
# INFOMANIAK_CLIENT_ID=
# INFOMANIAK_CLIENT_SECRET=
# INFOMANIAK_REDIRECT_URI=https://thesisframe.votre-domaine.ch/api/cloud-drive/callback
