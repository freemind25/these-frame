://huggingbay.xyz/rankings/eastern-small-local-models\"}},{\"@type\":\"ListItem\",\"position\":15,\"name\":\"Eastern small/local mirror pack\",\"url\":\"https://huggingbay.xyz/mirror-packs/eastern-small-local-models\",\"item\":{\"@type\":\"WebPage\",\"name\":\"Eastern small/local mirror pack\",\"url\":\"https://huggingbay.xyz/mirror-packs/eastern-small-local-models\"}},{\"@type\":\"ListItem\",\"position\":16,\"name\":\"Unqualified community evidence\",\"url\":\"https://huggingbay.xyz/rankings/community-verified\",\"item\":{\"@type\":\"WebPage\",\"name\":\"Unqualified community evidence\",\"url\":\"https://huggingbay.xyz/rankings/community-verified\"}},{\"@type\":\"ListItem\",\"position\":17,\"name\":\"Eastern open models\",\"url\":\"https://huggingbay.xyz/rankings/eastern-open-models\",\"item\":{\"@type\":\"WebPage\",\"name\":\"Eastern open models\",\"url\":\"https://huggingbay.xyz/rankings/eastern-open-models\"}},{\"@type\":\"ListItem\",\"position\":18,\"name\":\"Needs first review\",\"url\":\"https://huggingbay.xyz/rankings/needs-first-review\",\"item\":{\"@type\":\"WebPage\",\"name\":\"Needs first review\",\"url\":\"https://huggingbay.xyz/rankings/needs-first-review\"}},{\"@type\":\"ListItem\",\"position\":19,\"name\":\"Review action templates\",\"url\":\"https://huggingbay.xyz/api/community/review-actions\",\"item\":{\"@type\":\"WebPage\",\"name\":\"Review action templates\",\"url\":\"https://huggingbay.xyz/api/community/review-actions\"}},{\"@type\":\"ListItem\",\"position\":20,\"name\":\"Hosted downloads\",\"url\":\"https://huggingbay.xyz/downloads\",\"item\":{\"@type\":\"WebPage\",\"name\":\"Hosted downloads\",\"url\":\"https://huggingbay.xyz/downloads\"}},{\"@type\":\"ListItem\",\"position\":21,\"name\":\"Mirror request status\",\"url\":\"https://huggingbay.xyz/requests\",\"item\":{\"@type\":\"WebPage\",\"name\":\"Mirror request status\",\"url\":\"https://huggingbay.xyz/requests\"}},{\"@type\":\"ListItem\",\"position\":22,\"name\":\"Community trust queue\",\"url\":\"https://huggingbay.xyz/community\",\"item\":{\"@type\":\"WebPage\",\"name\":\"Community trust queue\",\"url\":\"https://huggingbay.xyz/community\"}},{\"@type\":\"ListItem\",\"position\":23,\"name\":\"API and agent docs\",\"url\":\"https://huggingbay.xyz/api\",\"item\":{\"@type\":\"WebPage\",\"name\":\"API and agent docs\",\"url\":\"https://huggingbay.xyz/api\"}}]}]}</script>\n  </head>\n  <body>\n    <noscript><a class=\"skip-link\" href=\"#home-seo-summary\">Skip to main content</a><header><a href=\"/\">Hugging Bay</a><nav aria-label=\"No-JavaScript navigation\"><a href=\"/browse\">Browse</a> <a href=\"/downloads\">Downloads</a> <a href=\"/agents\">Agents</a> <a href=\"/openapi.json\">OpenAPI</a></nav></header><main id=\"home-seo-summary\" tabindex=\"-1\"><section aria-labelledby=\"home-seo-summary-heading\"><h1 id=\"home-seo-summary-heading\">Hugging Bay</h1><p>Hugging Bay publishes open AI catalog metadata, source provenance, license records, neutral hosted-file inventory, answer packs, and recorded hashes. Canonical bundle verification and runtime readiness remain unknown.</p><ul><li><a href=\"/start\">Start using Hugging Bay</a></li><li><a href=\"/api/activation\">Activation API</a></li><li><a href=\"/browse\">Browse catalog</a></li><li><a href=\"/answers\">Answer packs</a></li><li><a href=\"/answers/hugging-face-alternative\">Hugging Face alternative answer</a></li><li><a href=\"/answers/verified-ai-registry\">Verified AI registry answer</a></li><li><a href=\"/answers/agent-friendly-ai-catalog\">Agent-friendly catalog answer</a></li><li><a href=\"/ai-search\">AI search guidance</a></li><li><a href=\"/browser-extension\">Hugging Face overlay</a></li><li><a href=\"/rankings/top-open-models\">Top open models</a></li><li><a href=\"/rankings/hosted-run-ready\">Hosted file metadata</a></li><li><a href=\"/rankings/hosted-small-local-model-files\">Hosted model file inventory</a></li><li><a href=\"/api/hosted-local-models?limit=100\">Hosted model metadata API</a></li><li><a href=\"/rankings/eastern-small-local-models\">Eastern small/local models</a></li><li><a href=\"/mirror-packs/eastern-small-local-models\">Eastern small/local mirror pack</a></li><li><a href=\"/rankings/community-verified\">Unqualified community evidence</a></li><li><a href=\"/rankings/eastern-open-models\">Eastern open models</a></li><li><a href=\"/rankings/needs-first-review\">Needs first review</a></li><li><a href=\"/api/community/review-actions\">Review action templates</a></li><li><a href=\"/downloads\">Hosted downloads</a></li><li><a href=\"/requests\">Mirror request status</a></li><li><a href=\"/community\">Community trust queue</a></li><li><a href=\"/api\">API and agent docs</a></li></ul><p><a href=\"/#/\">Open interactive page</a></p></section></main><footer><nav aria-label=\"Machine-readable resources\"><a href=\"/api/agent-discovery\">Agent discovery</a> <a href=\"/llms.txt\">llms.txt</a> <a href=\"/robots.txt\">robots.txt</a> <a href=\"/sitemap.xml\">sitemap.xml</a></nav><p>Public metadata and hosted-file inventory do not bypass gated or restricted upstream access controls.</p></footer></noscript><div id=\"root\"><div class=\"app-shell\"><header class=\"site-header\"><a class=\"skip-link\" href=\"#content\">Skip to content</a><a class=\"brand-home\" href=\"/\" aria-label=\"Hugging Bay home\"><img class=\"brand-art\" alt=\"\" aria-hidden=\"true\" src=\"/hugging-bay-header.jpg\"></a><nav aria-label=\"Primary navigation\" class=\"grouped-nav\"><div class=\"grouped-nav-desktop\"><div class=\"nav-group nav-group-active\"><button type=\"button\" class=\"nav-group-button\" aria-expanded=\"false\" aria-haspopup=\"true\" aria-controls=\"nav-group-find\">Find <span aria-hidden=\"true\" class=\"nav-group-caret\">▾</span></button></div><div class=\"nav-group\"><button type=\"button\" class=\"nav-group-button\" aria-expanded=\"false\" aria-haspopup=\"true\" aria-controls=\"nav-group-use\">Use <span aria-hidden=\"true\" class=\"nav-group-caret\">▾</span></button></div><div class=\"nav-group\"><button type=\"button\" class=\"nav-group-button\" aria-expanded=\"false\" aria-haspopup=\"true\" aria-controls=\"nav-group-verify\">Verify <span aria-hidden=\"true\" class=\"nav-group-caret\">▾</span></button></div><div class=\"nav-group\"><button type=\"button\" class=\"nav-group-button\" aria-expanded=\"false\" aria-haspopup=\"true\" aria-controls=\"nav-group-publish\">Publish <span aria-hidden=\"true\" class=\"nav-group-caret\">▾</span></button></div><div class=\"nav-group\"><button type=\"button\" class=\"nav-group-button\" aria-expanded=\"false\" aria-haspopup=\"true\" aria-controls=\"nav-group-developers\">Developers <span aria-hidden=\"true\" class=\"nav-group-caret\">▾</span></button></div><button type=\"button\" class=\"cmdk-trigger\" aria-label=\"Open command palette\" title=\"Search and jump (Cmd/Ctrl+K)\"><span aria-hidden=\"true\">⌘K</span></button></div><div class=\"grouped-nav-mobile\"><button type=\"button\" class=\"nav-menu-button\" aria-expanded=\"false\" aria-controls=\"nav-mobile-panel\">☰ Menu</button></div><span class=\"grouped-nav-controls\"><span class=\"rig-switcher\" title=\"Record hardware context; canonical fit remains unknown\"><span class=\"rig-switcher-face\" aria-hidden=\"true\"><span class=\"rig-switcher-icon\">🖥</span><span class=\"rig-switcher-name\">Set GPU</span><span class=\"rig-switcher-caret\">▾</span></span><select id=\"hb-rig-switcher\" class=\"rig-switcher-select\" aria-label=\"Your GPU context\"><option value=\"\">no GPU set</option><option value=\"t4-16\">NVIDIA T4 16GB (free Colab)</option><option value=\"l4-24\">NVIDIA L4 24GB</option><option value=\"rtx3060-12\">RTX 3060 12GB</option><option value=\"rtx4080-16\">RTX 4080 16GB</option><option value=\"rtx3090-24\">RTX 3090 24GB</option><option value=\"rtx4090-24\">RTX 4090 24GB</option><option value=\"a100-40\">A100 40GB</option><option value=\"a100-80\">A100 80GB</option><option value=\"h100-80\">H100 80GB</option><option value=\"apple-m-16\">Apple M-series 16GB (unified)</option><option value=\"apple-m-32\">Apple M-series 32GB (unified)</option><option value=\"apple-m-64\">Apple M-series 64GB (unified)</option><option value=\"apple-m-128\">Apple M-series 128GB (unified)</option><option value=\"cpu-ram-32\">CPU / 32GB system RAM</option><option value=\"cpu-ram-64\">CPU / 64GB system RAM</option></select></span></span></nav><section class=\"session-panel\" aria-label=\"Account\"><a class=\"text-button header-signin-link\" href=\"/account\">Sign in</a></section></header><main id=\"content\" class=\"page\" tabindex=\"-1\"><section class=\"home-lead\" aria-label=\"Get started\"><h1 class=\"sr-only\">Hugging Bay</h1><div class=\"home-lead-actions\"><form class=\"home-lead-card\" aria-label=\"Find model metadata for my hardware\"><h2 class=\"home-lead-title\">Find model metadata for my hardware</h2><div class=\"home-lead-row\"><label class=\"home-lead-field\"><span class=\"home-lead-field-label\">Task</span><select class=\"home-lead-select\" aria-label=\"Task\"><option value=\"chat\">Chat</option><option value=\"coding\">Coding</option><option value=\"embeddings\">Embeddings</option><option value=\"rag\">RAG</option><option value=\"ocr\">OCR</option></select></label><span class=\"home-lead-rig\" aria-label=\"Your hardware\">🖥 No GPU set</span><button type=\"submit\" class=\"retro-button home-lead-go\">Go</button></div><p class=\"home-lead-hint\">Set optional hardware metadata in the header. Opens the finder with your task and hardware prefilled; no runtime fit is implied.</p></form><form class=\"home-lead-card\" aria-label=\"Inspect a model or source URL\"><h2 class=\"home-lead-title\">Inspect a model or source URL</h2><div class=\"home-lead-row\"><input class=\"home-lead-input\" placeholder=\"https://huggingface.co/owner/model\" aria-label=\"Model or source URL\" type=\"text\" value=\"\"><button type=\"submit\" class=\"retro-button home-lead-go\">Inspect</button></div><p class=\"home-lead-hint\"