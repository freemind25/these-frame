    "html": "<html lang=\"en\"><head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"description\" content=\"Hugging Bay is a legal open AI artifact registry for models, datasets, apps, evals, and mirrors.\">\n    <link rel=\"icon\" href=\"/favicon.ico\" sizes=\"any\">\n    <link rel=\"icon\" type=\"image/png\" href=\"/favicon.png\">\n    <link rel=\"apple-touch-icon\" href=\"/favicon.png\">\n    <title>Hugging Bay</title>\n    <script type=\"module\" crossorigin=\"\" src=\"/assets/index-ehYxAmfe.js\"></script>\n    <link rel=\"stylesheet\" crossorigin=\"\" href=\"/assets/index-BBx-mlFC.css\">\n      <link rel=\"canonical\" href=\"https://huggingbay.xyz/\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:site_name\" content=\"Hugging Bay\">\n    <meta property=\"og:title\" content=\"Hugging Bay | Open AI Artifact Metadata\">\n    <meta property=\"og:description\" content=\"Hugging Bay publishes open AI catalog metadata, source provenance, license records, neutral hosted-file inventory, answer packs, and recorded hashes. Canonical bundle verification and runtime readiness remain unknown.\">\n    <meta property=\"og:url\" content=\"https://huggingbay.xyz/\">\n    <meta property=\"og:image\" content=\"https://huggingbay.xyz/hugging-bay-header.jpg\">\n    <meta property=\"og:image:secure_url\" content=\"https://huggingbay.xyz/hugging-bay-header.jpg\">\n    <meta property=\"og:image:type\" content=\"image/jpeg\">\n    <meta property=\"og:image:width\" content=\"720\">\n    <meta property=\"og:image:height\" content=\"382\">\n    <meta property=\"og:image:alt\" content=\"Hugging Bay open AI artifact metadata catalog\">\n    <meta name=\"twitter:card\" content=\"summary_large_image\">\n    <meta name=\"twitter:title\" content=\"Hugging Bay | Open AI Artifact Metadata\">\n    <meta name=\"twitter:description\" content=\"Hugging Bay publishes open AI catalog metadata, source provenance, license records, neutral hosted-file inventory, answer packs, and recorded hashes. Canonical bundle verification and runtime readiness remain unknown.\">\n    <meta name=\"twitter:url\" content=\"https://huggingbay.xyz/\">\n    <meta name=\"twitter:image\" content=\"https://huggingbay.xyz/hugging-bay-header.jpg\">\n    <meta name=\"twitter:image:alt\" content=\"Hugging Bay open AI artifact metadata catalog\">\n    <link rel=\"image_src\" href=\"https://huggingbay.xyz/hugging-bay-header.jpg\">\n    <meta name=\"ai:site\" content=\"Hugging Bay\">\n    <meta name=\"ai:purpose\" content=\"Open-source AI artifact metadata discovery with provenance, license, hosted-file inventory, and agent-readable APIs. Canonical runtime and verification state remain unknown.\">\n    <meta name=\"ai:agent-discovery\" content=\"https://huggingbay.xyz/.well-known/agent-discovery.json\">\n    <meta name=\"ai:agent-discovery-api\" content=\"https://huggingbay.xyz/api/agent-discovery\">\n    <meta name=\"ai:openapi\" content=\"https://huggingbay.xyz/openapi.json\">\n    <meta name=\"ai:mcp\" content=\"https://huggingbay.xyz/api/mcp\">\n    <meta name=\"ai:citations\" content=\"https://huggingbay.xyz/api/citations\">\n    <meta name=\"ai:indexing-status\" content=\"https://huggingbay.xyz/api/indexing/status\">\n    <meta name=\"citation_title\" content=\"Hugging Bay | Open AI Artifact Metadata\">\n    <meta name=\"citation_public_url\" content=\"https://huggingbay.xyz/\">\n    <meta name=\"citation_description\" content=\"Hugging Bay publishes open AI catalog metadata, source provenance, license records, neutral hosted-file inventory, answer packs, and recorded hashes. Canonical bundle verification and runtime readiness remain unknown.\">\n    <!--\n    <PageMap>\n      <DataObject type=\"huggingbay-agent\">\n        <Attribute name=\"site\">Hugging Bay</Attribute>\n        <Attribute name=\"page_type\">WebPage</Attribute>\n        <Attribute name=\"canonical\">https://h