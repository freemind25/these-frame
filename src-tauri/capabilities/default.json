{
  "$schema": "https://raw.githubusercontent.com/nickel-lang/json-schema-store/main/tauri.schema.json",
  "identifier": "default",
  "description": "Default permissions for ThesisFrame",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-read",
      "allow": [{ "path": "$DOCUMENT/**" }, { "path": "$DESKTOP/**" }]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [{ "path": "$DOCUMENT/**" }]
    }
  ]
}